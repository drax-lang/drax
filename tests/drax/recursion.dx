### tail recursion with accumulator
fun sum_to(n, acc) do
    if (n == 0) do
        acc
    else
        sum_to(n - 1, acc + n)
    end
end

assert(sum_to(10, 0) == 55, "recursion error: sum_to(10)")
assert(sum_to(100000, 0) == 5000050000, "recursion error: sum_to(100000)")
assert(sum_to(3000000, 0) == 4500001500000, "recursion error: TCO must not grow the stack")

### early return inside a recursive loop
fun find(n, target) do
    if (n == target) do
        return n
    end
    if (n > 3000) do
        return nil
    end
    find(n + 1, target)
end

assert(find(0, 2000) == 2000, "recursion error: early return in tail loop")
assert(find(0, 5000) == nil, "recursion error: bound reached")

### tail recursion through pipe
fun count_down(n) do
    if (n == 0) do
        "done"
    else
        n - 1 |> count_down()
    end
end

assert(count_down(500000) == "done", "recursion error: pipe tail recursion")

### recursion where the call is NOT the last expression of the function
fun fact(n) do
    if (n < 2) do
        return 1
    end
    r = fact(n - 1)
    n * r
end

assert(fact(1) == 1, "recursion error: fact(1)")
assert(fact(5) == 120, "recursion error: fact(5)")
assert(fact(10) == 3628800, "recursion error: fact(10)")

### the early-return style works for non tail calls
fun depth(n) do
    if (n == 0) do
        return 0
    end
    1 + depth(n - 1)
end

assert(depth(0) == 0, "recursion error: depth(0)")
assert(depth(50) == 50, "recursion error: depth(50)")

### recursion over data
fun list_sum(l, acc) do
    if (List.is_empty(l)) do
        acc
    else
        list_sum(List.tail(l), acc + List.at(l, 0))
    end
end

assert(list_sum([1, 2, 3, 4], 0) == 10, "recursion error: list_sum")
assert(list_sum([], 0) == 0, "recursion error: list_sum([])")

### self call operator
fun self_sum(n, acc) do
    if (n == 0) do
        return acc
    end
    &(n - 1, acc + n)
end

### body recursion (the call is not the last operation)
### like in Erlang, the stack grows on demand, deep recursion works.
fun sum_body(n) do
    if (n == 0) do
        0
    else
        n + sum_body(n - 1)
    end
end

assert(sum_body(5) == 15, "recursion error: n + f(n - 1) inside else")
assert(sum_body(100000) == 5000050000, "recursion error: body recursion 100_000 deep")
assert(sum_body(1000000) == 500000500000, "recursion error: body recursion 1_000_000 deep")

fun fib(n) do
    if (n < 2) do
        n
    else
        fib(n - 1) + fib(n - 2)
    end
end

assert(fib(20) == 6765, "recursion error: fib(20)")

fun id(n) do n end

fun in_list(n) do
    if (n > 0) do [n, id(n)] end
end
assert(in_list(2) == [2, 2], "recursion error: call inside list literal in if")

fun in_frame(n) do
    if (n > 0) do { a: id(n) } end
end
assert(in_frame(2) == { a: 2 }, "recursion error: call inside frame literal in if")

fun in_concat(n) do
    if (n > 0) do "x" ++ id("y") end
end
assert(in_concat(1) == "xy", "recursion error: call inside concat in if")

fun in_assign(n) do
    if (n == 0) do
        0
    else
        x = id(n)
        x + 1
    end
end
assert(in_assign(5) == 6, "recursion error: assignment of call inside else")

fun neg(n) do
    if (n > 0) do -id(n) end
end

fun inv(n) do
    if (n > 0) do !id(n) end
end

assert(neg(5) == -5, "recursion error: -id(5) inside if")
assert(inv(5) == false, "recursion error: !id(5) inside if")

### body recursion building a list (map)
fun my_map(l, f) do
    if (List.is_empty(l)) do
        []
    else
        [f(List.at(l, 0))] ++ my_map(List.tail(l), f)
    end
end

assert(my_map([1, 2, 3], fun (x) x * 10 end) == [10, 20, 30], "recursion error: body recursive map")

### recursion through a native function (List.map calls back into Drax)
fun nest(n) do
    if (n == 0) do
        0
    else
        1 + List.at(List.map([n - 1], nest), 0)
    end
end

assert(nest(1000) == 1000, "recursion error: recursion through List.map")

print("Recursion done!")
