### BUG: an `if` without `else` whose condition is false must evaluate to nil.
### Today it leaves garbage on the VM stack: the value is 0 and passing it to
### another call fails with "vm_error: function is not valid!".

r = if (false) do 1 end
assert(r == nil, "bug: if without else must be nil when false")

fun maybe(x) do
    if (x) do 1 end
end

assert(maybe(false) == nil, "bug: function ending in a false if must return nil")
assert(typeof(maybe(false)) == "nil", "bug: typeof of false if without else")
assert(maybe(true) == 1, "bug: true branch")

print("if_without_else_value fixed!")
