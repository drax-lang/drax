### BUG: heap-buffer-overflow in new_derror (src/dstructs.c:58): malloc(strlen(msg))
### without room for the '\0'. Depending on the message length a failing assert
### aborts with "malloc(): invalid next size" (exit 134) instead of exit 1.
### Confirmed with -fsanitize=address.

r = Os.cmd_with_status("./bin/drax ./tests/drax/known_bugs/_assert_long.dx 2>&1")
assert(List.at(r, 0) == 1, "bug: a failing assert must exit with status 1")
assert(String.contains(List.at(r, 1), "custom assertion message"), "bug: message must be reported")

print("assert_long_message fixed!")
