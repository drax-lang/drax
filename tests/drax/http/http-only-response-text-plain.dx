## Minimal server (manual example): ./bin/drax tests/drax/http/http-only-response-text-plain.dx
## then: curl http://localhost:8081
## The code is sequential: accept, read, answer, close, repeat.

server = TCPServer.new({ host: '127.0.0.1', port: '8081' })

fun serve(server) do
    conn = TCPServer.accept(server)
    req = Http.read_request(conn)

    if (req != nil) do
        TCPServer.send(conn, Http.response(200, { 'content-type': 'text/plain' }, 'drax-lang'))
    end

    TCPServer.disconnect(conn)
    serve(server)
end

serve(server)
