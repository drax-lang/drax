assert(typeof(1) == "number", "types error: number")
assert(typeof(1.5) == "number", "types error: float")
assert(typeof("s") == "string", "types error: string")
assert(typeof('s') == "string", "types error: single quoted string")
assert(typeof("""s""") == "string", "types error: multiline string")
assert(typeof([]) == "list", "types error: list")
assert(typeof({}) == "frame", "types error: frame")
assert(typeof(nil) == "nil", "types error: nil")
assert(typeof(true) == "boolean", "types error: true")
assert(typeof(false) == "boolean", "types error: false")
assert(typeof(print) == "function", "types error: native function")
assert(typeof(fun () 1 end) == "function", "types error: lambda")
assert(typeof(Core) == "module", "types error: module")
assert(typeof(1 == 1) == "boolean", "types error: comparison result")
assert(typeof(1 + 1) == "number", "types error: arithmetic result")
assert(typeof("a" ++ "b") == "string", "types error: concat result")
assert(typeof(List.length([])) == "number", "types error: length result")
assert(typeof(Frame.keys({})) == "list", "types error: keys result")
assert(typeof(nil) == typeof(nil), "types error: typeof is comparable")
assert(typeof(typeof(1)) == "string", "types error: typeof returns a string")

fun named() do end
assert(typeof(named) == "function", "types error: named function reference")
assert(typeof(named()) == "nil", "types error: empty function returns nil")

### conversions
assert(Number.to_string(42) == "42", "types error: Number.to_string int")
assert(Number.to_string(0) == "0", "types error: Number.to_string 0")
assert(Number.to_string(-1.5) == "-1.5", "types error: Number.to_string negative float")
assert(String.to_number("42") == 42, "types error: String.to_number int")
assert(String.to_number("-3") == -3, "types error: String.to_number negative")
assert(String.to_number("12.5") == 12.5, "types error: String.to_number float")
assert(String.to_number(Number.to_string(123)) == 123, "types error: number/string roundtrip")
assert(Number.to_string(String.to_number("77")) == "77", "types error: string/number roundtrip")

print("Types done!")
